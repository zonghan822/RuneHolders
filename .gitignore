# Ignore build directories
build/
Build/
bin/
Bin/

# Ignore CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Ignore Visual Studio files
*.sln
*.vcxproj*
*.vcxproj.filters
*.vcxproj.user
*.user
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.dir/
.vs/
*.ipch

# Ignore Xcode files (macOS)
*.xcworkspace/
*.xcuserstate
*.xcodeproj/
*.xcuserdata/

# Ignore Qt generated files
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# Ignore macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Directories potentially created on remote AFP share
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Ignore Ubuntu system files
*~
\#*\#
*.swp
*.swo

# Ignore log files
*.log

# Ignore temporary files
*.tmp
*.temp
*.swp
*.bak
*.old

# Ignore binary files
*.exe
*.pdb
*.o
*.a
*.so
*.dylib

# Ignore other intermediate or output directories
out/
Debug/
Release/
dist/
*.dSYM/

# Ignore the obj and bin folders generated by .NET
**/obj/
**/bin/

# Runtime-generated files
crashlogs/
imgui.ini

# Packaged game output from ship.bat / ship-Debug.bat
/GameEngine/RuneWeavers/

# Installer: only the Inno Setup script and its small support files are tracked.
# GAMEDIRECTORY is a copy of the ship.bat output; the built setup exe and the
# VC++ redistributable are uploaded to GitHub Releases instead.
/Installer/GAMEDIRECTORY/*
!/Installer/GAMEDIRECTORY/Icon.ico
/Installer/INSTALLER/
/Installer/REDIST/

# Videos over GitHub's 100 MB file limit are hosted on GitHub Releases
/media/RuneWeavers_Gameplay.mp4
/media/PersonalContribution_*.mp4

# Keep lib directory
!GameEngine/lib/
!GameEngine/lib/**